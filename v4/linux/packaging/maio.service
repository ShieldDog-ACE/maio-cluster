[Unit]
Description=maio v4 distributed llama.cpp cluster
Documentation=https://github.com/ShieldDog-ACE/maio-cluster
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=maio
Group=maio
ExecStart=/usr/bin/maio --system --config /etc/maio/cluster.toml cluster up
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/maio /var/log/maio
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=1048576
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

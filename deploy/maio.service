[Unit]
Description=maio model management service
Documentation=https://github.com/ShieldDog-ACE/maio-cluster
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/maio serve
Environment=MAIO_CONF=/etc/maio/maio.conf
Environment=HOME=/var/lib/maio
User=maio
Group=maio
SupplementaryGroups=video render
StateDirectory=maio
StateDirectoryMode=0750
Restart=always
RestartSec=2
WatchdogSec=30
TimeoutStartSec=120
TimeoutStopSec=45
KillMode=mixed
SendSIGKILL=yes
OOMPolicy=stop
LimitNOFILE=1048576
LimitNPROC=8192
TasksMax=8192
CapabilityBoundingSet=

# sandbox: the service reads the model store and writes only its state dir
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
ReadWritePaths=-/var/lib/maio
ReadOnlyPaths=-/var/lib/maio/models

[Install]
WantedBy=multi-user.target

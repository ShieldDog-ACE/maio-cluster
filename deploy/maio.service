[Unit]
Description=maio model management service
Documentation=https://github.com/ShieldDog-ACE/maio-cluster
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/maio serve
Environment=MAIO_CONF=/etc/maio/maio.conf
Restart=on-failure
RestartSec=3
LimitNOFILE=524288
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target

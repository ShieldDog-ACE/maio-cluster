#!/usr/bin/env bash
# maio-cluster source installer.
#
#   sudo bash maio-cluster                 install and start on boot (default)
#   sudo bash maio-cluster --no-start      install only
#   sudo bash maio-cluster --boot 0        install with start-on-boot disabled
#
# The supported packaged path is: sudo apt install maio-cluster
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$ROOT/bin/maio"
DEST="/usr/local/bin/maio"
CONF_DIR="/etc/maio"
CONF="$CONF_DIR/maio.conf"
STATE_DIR="/var/lib/maio"
MODELS_ROOT="$STATE_DIR/models"
BOOT=1
START=1

while [ $# -gt 0 ]; do
  case "$1" in
    --no-start) START=0 ;;
    --boot)
      shift
      [ $# -gt 0 ] || { echo "--boot requires 0 or 1" >&2; exit 1; }
      BOOT="$1"
      ;;
    -h|--help)
      sed -n '2,10p' "$0"
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 1
      ;;
  esac
  shift
done

if [ "$(id -u)" -ne 0 ]; then
  echo "run as root: sudo bash maio-cluster" >&2
  exit 1
fi
if [ ! -x "$SRC" ]; then
  echo "missing $SRC; run make build first" >&2
  exit 1
fi

install -m 0755 "$SRC" "$DEST"
install -d -m 0755 "$CONF_DIR" "$STATE_DIR" "$MODELS_ROOT"
install -d -m 0750 "$STATE_DIR/run" "$STATE_DIR/log" "$STATE_DIR/upgrade"
install -d -m 0700 "$STATE_DIR/auth"

# Dedicated unprivileged service account for the default config.
if ! getent passwd maio >/dev/null 2>&1; then
  adduser --system --group --home "$STATE_DIR" --no-create-home \
    --shell /usr/sbin/nologin maio >/dev/null 2>&1 || true
fi
for grp in video render; do
  if getent group "$grp" >/dev/null 2>&1; then
    adduser maio "$grp" >/dev/null 2>&1 || true
  fi
done
if getent passwd maio >/dev/null 2>&1; then
  chown maio:maio "$STATE_DIR" 2>/dev/null || true
  chown -R maio:maio "$STATE_DIR/run" "$STATE_DIR/log" "$STATE_DIR/auth" "$STATE_DIR/upgrade" 2>/dev/null || true
  chgrp maio "$MODELS_ROOT" 2>/dev/null || true
  chmod 0750 "$MODELS_ROOT" 2>/dev/null || true
fi

if [ ! -f "$CONF" ]; then
  cat > "$CONF" <<EOF
# maio global config (one per machine; not maio.toml)
# Start-on-boot is on by default. Use "sudo maio boot 0" to disable it.

boot        = $BOOT
models_root = "$MODELS_ROOT"
state_dir   = "$STATE_DIR"
mirror      = "https://www.modelscope.cn"

host           = "127.0.0.1"
port           = 11434
auth           = "auto"
api_key        = ""
allow_insecure = 0
trust_proxy    = 0
cors           = 0
tls_cert       = ""
tls_key        = ""
tls_ca         = ""

rate_limit      = 600
rate_burst      = 120
max_concurrency = 8
max_queue       = 64
queue_timeout   = 300
request_timeout = 0
max_body_mb     = 16
idle_unload     = 300
access_log      = 1

llama_bin  = ""
llama_lib  = ""
ctx_size   = 0
parallel   = 2
threads    = 0
kv_type    = "f16"
flash_attn = "auto"
mmap       = 1
llama_log_verbosity = 3

memory_limit_mb = 180
max_procs       = 0
max_open_files  = 1048576
restore         = 1
run_as          = "maio"
EOF
  chgrp maio "$CONF" 2>/dev/null || true
  chmod 0640 "$CONF" 2>/dev/null || true
  echo "default config written: $CONF"
else
  echo "keeping existing config: $CONF"
fi

echo "installed: $DEST"
if [ "$START" -eq 1 ]; then
  if "$DEST" boot "$BOOT"; then
    if command -v systemctl >/dev/null 2>&1; then
      systemctl try-restart maio >/dev/null 2>&1 || true
    fi
    echo "start-on-boot: boot = $BOOT"
  else
    echo "warning: could not configure the service; run manually: maio serve" >&2
  fi
else
  echo "start-on-boot not configured (--no-start)"
fi
echo "next: set llama_bin in $CONF to your llama-server (or install maio-llama), then run: maio doctor"
